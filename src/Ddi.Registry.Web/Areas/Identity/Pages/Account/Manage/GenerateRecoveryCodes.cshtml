@page
@model GenerateRecoveryCodesModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4>@ViewData["Title"]</h4>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>@Localizer["SafePlace"]</strong>
    </p>
    <p>
        @Localizer["Body1"]
    </p>
    <p>
        @Localizer["Body2"] <a asp-page="./ResetAuthenticator">@Localizer["ResetKeys"]</a>
    </p>
</div>
<div>
    <form method="post" class="form-group">
        <button class="btn btn-danger" type="submit">@Localizer["GenerateCodes"]</button>
    </form>
</div>