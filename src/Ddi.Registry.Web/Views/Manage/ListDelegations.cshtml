@model IEnumerable<Ddi.Registry.Data.Delegation>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Localizer["NameServer"]
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.NameServer)
                </td>
                <td>
                    @Html.ActionLink(Localizer["Edit"].Value, "EditDelegation", new { delegationId = item.DelegationId }) |
                    @Html.ActionLink(Localizer["Delete"].Value, "DeleteDelegation", new { delegationId = item.DelegationId })
                </td>
            </tr>
        }
    </tbody>
</table>
