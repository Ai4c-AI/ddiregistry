@model Ddi.Registry.Data.Delegation
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EditPrefix"].Value + " " + Model.NameServer;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Localizer["EditDelegation"]</h2>




@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <fieldset>
        @Html.HiddenFor(model => model.AssignmentId)
        @Html.HiddenFor(model => model.DelegationId)

        <div class="editor-label">
            @Html.LabelFor(model => model.NameServer, Localizer["NameServer"].Value)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.NameServer, new { autofocus = "true" })
            @Html.ValidationMessageFor(model => model.NameServer)
        </div>

        <div class="editor-submit">
            <p>
                <input type="submit" value="@Localizer["Save"]" />
            </p>
        </div>
    </fieldset>
}

<div>
    @Html.ActionLink(Localizer["BackToAssignment"].Value, "EditAssignment", new { assignmentId = Model.AssignmentId })
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}