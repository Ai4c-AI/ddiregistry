@model Ddi.Registry.Web.Models.OverviewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"].Value;
	
	var approvedAgencies = Model.Agencies.Where(m => m.ApprovalState == Ddi.Registry.Data.ApprovalState.Approved).ToList();
	var requestedAgencies = Model.Agencies.Where(m => m.ApprovalState == Ddi.Registry.Data.ApprovalState.Requested).ToList();
}

<h2>@Localizer["Agencies"]</h2>
@if (approvedAgencies.Count == 0)
{
	<p>@Localizer["NoApprovedAgencies"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["AgencyName"]</th>
                <th>@Localizer["AgencyLabel"]</th>
                <th>@Localizer["Created"]</th>
                <th>@Localizer["Modified"]</th>
                <th>@Localizer["AdministrativeContact"]</th>
                <th>@Localizer["TechnicalContact"]</th>
                <th>@Localizer["Status"]</th>
                <th></th>
            </tr>
        </thead>

        @functions {

        public string GetName(string personId)
        {
            foreach (Ddi.Registry.Data.ApplicationUser p in Model.People)
            {
                if (p.Id == personId) { return p.Name; }
            }
            return "none";
        }
        }
        <tbody>
            @foreach (var item in approvedAgencies)
            {
                <tr>
                    <td>@item.AgencyId</td>
                    <td>@item.Label</td>
                    <td>@item.DateCreated</td>
                    <td>@item.LastModified</td>
                    <td>@GetName(item.AdminContactId)</td>
                    <td>@GetName(item.TechnicalContactId)</td>
                    <td>@item.ApprovalState.ToString()</td>
                    <td>
                        @Html.ActionLink(Localizer["Manage"].Value, "ViewAgency", new { agencyId = item.AgencyId }) |
                        @Html.ActionLink(Localizer["Edit"].Value, "EditAgency", new { agencyId = item.AgencyId })

                    </td>
                </tr>
            }
        </tbody>
</table>
}

<h2>@Localizer["PendingRequests"]</h2>

@if (requestedAgencies.Count == 0)
{
	<p>@Localizer["NoPendingRequests"]</p>
}

<p>@Html.ActionLink(Localizer["RequestNewAgency"].Value, "AddAgency")</p>


@if (requestedAgencies.Count > 0)
{
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["AgencyName"]</th>
            <th>@Localizer["RequestedOn"]</th>
            <th>@Localizer["Status"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in requestedAgencies)
        {
            <tr>
                <td>@item.AgencyId</td>
                <td>@item.DateCreated</td>
                <td>@item.ApprovalState.ToString()</td>
                <td>
                    @Html.ActionLink(Localizer["EditContacts"].Value, "EditAgency", new { agencyId = item.AgencyId })
                </td>
            </tr>
        }
    </tbody>
</table>
}


<h2>@Localizer["RelatedPeople"]</h2>


@if (Model.People.Count() == 0)
{

}
else
{
<table class="table table-striped">
    <thead>
        <tr>
            <th></th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Email"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.People)
        {
            <tr>
                <td><img gravatar-email="@item.Email" gravatar-size="80" gravatar-default-image="mm" /></td>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>
                    @Html.ActionLink(Localizer["Details"].Value, "ViewPerson", new { personId = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
}
