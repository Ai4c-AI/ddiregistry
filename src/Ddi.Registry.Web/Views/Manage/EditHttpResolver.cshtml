@using Ddi.Registry.Data
@model Ddi.Registry.Data.HttpResolver
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EditPrefix"].Value + " " + Model.ResolutionType;
}

<h2>@Localizer["EditPrefix"] @Model.ResolutionType</h2>




@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <fieldset>

        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.AssignmentId)

        
        <h2>@Localizer["ResolutionTypeHeading"]</h2>
        <div>
            <p>@Localizer["ResolutionTypeHint"]</p>
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.ResolutionType)
        </div>
        <div class="editor-field">
            <input asp-for="ResolutionType" class="form-control" value="@Model.ResolutionType" readonly />
            @Html.ValidationMessageFor(model => model.ResolutionType)
        </div>
        <br/>

        <h2>@Localizer["UrlTemplateHeading"]</h2>
        <div>
            <p>@Localizer["UrlTemplateHint"]</p>
            <p>@Localizer["UrlTemplateExample"]</p>
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.UrlTemplate)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.UrlTemplate)
            @Html.ValidationMessageFor(model => model.UrlTemplate)
        </div>

        <br/>


        <div class="editor-submit">
            <p>
                <input type="submit" value="@Localizer["Save"]" />
            </p>
        </div>
    </fieldset>
}

<div>
    @Html.ActionLink(Localizer["BackToAssignment"].Value, "EditAssignment", new { assignmentId = Model.AssignmentId })
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}