@model Ddi.Registry.Web.Models.AssignmentModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EditPrefix"].Value + " " + Model.AssignmentId;
}

<h2>@Localizer["EditPrefix"] @Model.AssignmentId</h2>




@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <fieldset>
        @Html.HiddenFor(model => model.AssignmentId)

        <div class="editor-label">
            @Html.LabelFor(model => model.AssignmentId)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.AssignmentId, new { @readonly = true })
            @Html.ValidationMessageFor(model => model.AssignmentId)
        </div>

    </fieldset>

    
    <fieldset>
        <legend>@Localizer["HttpResolvers"]</legend>

        <div style="margin-top: 12px;">
            <p>@Html.ActionLink(Localizer["AddHttpResolver"].Value, "AddHttpResolver", new { assignmentId = Model.AssignmentId })</p>
        </div>

        @if (Model.HttpResolvers.Count() > 0)
        {
            <partial name="ListHttpResolvers" for="HttpResolvers" />
        }
    </fieldset>

    <fieldset>
        <legend>@Localizer["DnsSrvServices"]</legend>

        @if (Model.IsDelegated)
        {
            <p><strong>@Localizer["ServicesInactive"] @Model.AssignmentId @Localizer["ServicesInactiveTail"]</strong></p>
        }

        <div style="margin-top: 12px;">
            <p>@Html.ActionLink(Localizer["AddService"].Value, "AddService", new { assignmentId = Model.AssignmentId })</p>
        </div>

        @if (Model.Services.Count() > 0)
        {
            <partial name="ListServices" for="Services" />
        }
    </fieldset>

    <fieldset>
        <legend>
            @Localizer["Delegations"] @if (!Model.IsDelegated)
            {<text>@Localizer["Disabled"]</text>}
        </legend>

        <div class="editor-field">
            @Html.EditorFor(model => model.Delegated)
            @Html.LabelFor(model => model.Delegated, Localizer["UseOwnNameServers"].Value)
            @Html.ValidationMessageFor(model => model.Delegated)
        </div>

        <div style="padding-top: 12px; clear: both;">
            <p>@Html.ActionLink(Localizer["AddNameserver"].Value, "AddDelegation", new { assignmentId = Model.AssignmentId })</p>
        </div>

        @if (Model.Delegations.Count() > 0)
        {
            <partial name="ListDelegations" for="Delegations" />
        }

    </fieldset>

    <div class="editor-submit">
        <p>
            <input type="submit" value="Save" />
        </p>
    </div>
}

<div>
    @Html.ActionLink("Back to Agency Page", "ViewAgency", new { agencyId = Model.AgencyId })
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}