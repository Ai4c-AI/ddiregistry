@model IEnumerable<Ddi.Registry.Data.Service>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Localizer["ServiceName"]
            </th>
            <th>
                @Localizer["Hostname"]
            </th>
            <th>
                @Localizer["Port"]
            </th>
            <th>
                @Localizer["Protocol"]
            </th>
            <th>
                @Localizer["TimeToLive"]
            </th>
            <th>
                @Localizer["Priority"]
            </th>
            <th>
                @Localizer["Weight"]
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ServiceName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Hostname)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Port)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Protocol)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TimeToLive)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Priority)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Weight)
                </td>
                <td>
                    @Html.ActionLink(Localizer["Edit"].Value, "EditService", new { serviceId = item.ServiceId }) |
                    @Html.ActionLink(Localizer["Delete"].Value, "DeleteService", new { serviceId = item.ServiceId })
                </td>
            </tr>
        }
    </tbody>
</table>
