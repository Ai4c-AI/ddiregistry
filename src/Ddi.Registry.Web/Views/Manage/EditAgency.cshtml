@model Ddi.Registry.Web.Models.AgencyModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["TitlePrefix"].Value + " " + Model.AgencyId;
}

<h2>@Localizer["EditPrefix"] @Model.AgencyId</h2>





<form asp-controller="Manage" asp-action="EditAgency" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input asp-for="AgencyId" hidden />

    <div class="form-group">
        <label asp-for="Label"></label>
        <input asp-for="Label" class="form-control" />
        <span asp-validation-for="Label" class="text-danger"></span>
    </div>

    <p>@Localizer["AdminContactPrompt"]</p>

    <div class="form-group">
        <label asp-for="AdminContactId"></label>
        <select asp-for="AdminContactId" asp-items="@(new SelectList(ViewBag.People, "Id", "Email"," "))" class="form-control">
            <option value="">@Localizer["NoneOrOther"]</option>
        </select>
        <input asp-for="AdminContactEmail" class="form-control" placeholder="@Localizer["OrEnterEmail"]" />
        <span asp-validation-for="AdminContactId" class="text-danger"></span>
    </div>

    <p>@Localizer["TechnicalContactPrompt"]</p>

    <div class="form-group">
        <label asp-for="TechnicalContactId"></label>
        <select asp-for="TechnicalContactId" asp-items="@(new SelectList(ViewBag.People, "Id", "Email"," "))" class="form-control">
            <option value="">@Localizer["NoneOrOther"]</option>
        </select>
        <input asp-for="TechnicalContactEmail" class="form-control" placeholder="@Localizer["OrEnterEmail"]" />
        <span asp-validation-for="TechnicalContactId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>


</form>

<div>
    @Html.ActionLink(Localizer["BackToManagement"].Value, "Index")
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}