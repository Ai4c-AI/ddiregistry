@model Ddi.Registry.Data.Service
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["DeletePrefix"].Value + " " + Model.ServiceName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Localizer["DeleteServiceHeading"]</h2>

<h3>@Localizer["ConfirmDelete"]</h3>
<fieldset>
	<div class="display-label">@Localizer["ServiceName"]</div>
    <div class="display-field">@Model.ServiceName</div>

    <div class="display-label">@Localizer["Protocol"]</div>
    <div class="display-field">@Model.Protocol</div>

    <div class="display-label">@Localizer["Hostname"]</div>
    <div class="display-field">@Model.Hostname</div>

    <div class="display-label">@Localizer["Port"]</div>
    <div class="display-field">@Model.Port</div>

    <div class="display-label">@Localizer["TimeToLive"]</div>
    <div class="display-field">@Model.TimeToLive</div>

    <div class="display-label">@Localizer["Priority"]</div>
    <div class="display-field">@Model.Priority</div>

    <div class="display-label">@Localizer["Weight"]</div>
    <div class="display-field">@Model.Weight</div>
</fieldset>
@using (Html.BeginForm()) {
    <p>
		@Html.HiddenFor(s => s.ServiceId)
        <input type="submit" value="@Localizer["Delete"]" /> |
        @Html.ActionLink(Localizer["BackToAssignment"].Value, "EditAssignment", new { assignmentId = Model.AssignmentId })
    </p>
}


