@model Ddi.Registry.Data.Delegation
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["DeletePrefix"].Value + " " + Model.NameServer;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Localizer["DeleteDelegationHeading"] @Model.NameServer</h2>

<h3>@Localizer["ConfirmDelete"]</h3>
<fieldset>
    <div class="display-label">@Localizer["NameServer"]</div>
    <div class="display-field">@Model.NameServer</div>
</fieldset>
@using (Html.BeginForm()) {
    <p>
		@Html.HiddenFor(d => d.DelegationId)
        <input type="submit" value="@Localizer["Delete"]" /> |
        @Html.ActionLink(Localizer["BackToAssignment"].Value, "EditAssignment", new { assignmentId = Model.AssignmentId })
    </p>
}


