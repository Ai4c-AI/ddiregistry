@model Ddi.Registry.Web.Models.AssignmentModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<h2>@Localizer["Heading"]</h2>




@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <fieldset>
        @Html.HiddenFor(model => model.AgencyId)

        <p>@Localizer["Prompt"] "@(Model.AgencyId)."</p>
        @Html.TextBoxFor(model => model.AssignmentId, new { autofocus = "true" })
        @Html.ValidationMessageFor(model => model.AssignmentId)

        <div class="editor-submit">
            <p>
                <input type="submit" value="@Localizer["Create"]" />
            </p>
        </div>
    </fieldset>
}

<div>
    @Html.ActionLink(Localizer["BackToManagement"].Value, "ViewAgency", new { agencyId = Model.AgencyId })
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}