@model Ddi.Registry.Web.Models.AgencyOverviewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Model.Agency.AgencyId;
}

<h2>@Model.Agency.AgencyId</h2>

<partial name="AgencyControl" for="Agency" />

<h2>@Localizer["AgencyAndSubAgencyAssignments"]</h2>

<p>@Html.ActionLink(Localizer["AddSubAgencyAssignment"].Value, "AddAssignment", new { agencyId = Model.Agency.AgencyId })</p>

@if (Model.Assignments.Count() == 0)
{
    <p>@Localizer["NoSubAgenciesAssigned"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["HttpResolutionServices"]</th>
                <th>@Localizer["DnsSrvServices"]</th>
                <th>@Localizer["IsDnsDelegated"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Ddi.Registry.Data.Assignment a in Model.Assignments)
            {
                <text>
                    <tr>
                        <td>@a.AssignmentId</td>
                        <td>@Model.HttpResolvers[a.AssignmentId].Count()</td>
                        <td>@Model.Services[a.AssignmentId].Count()</td>
                        <td>@a.IsDelegated</td>
                        <td>
                            @Html.ActionLink(Localizer["Edit"].Value, "EditAssignment", new { assignmentId = a.AssignmentId })
                            @if (a.AssignmentId != Model.Agency.AgencyId)
                            {
                                <text>| @Html.ActionLink(Localizer["Delete"].Value, "DeleteAssignment", new { assignmentId = a.AssignmentId })</text>
            }
                        </td>
                    </tr>
                    </text>
                }
        </tbody>
    </table>
}

<h2>@Localizer["ConceptRegistrations"]</h2>

<p>@Html.ActionLink(Localizer["AddConceptRegistration"].Value, "AddConceptRegistration", new { agencyId = Model.Agency.AgencyId })</p>

@if (!Model.Concepts.Any())
{
    <p>@Localizer["NoConceptRegistrations"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Version"]</th>
                <th>@Localizer["Label"]</th>
                <th>@Localizer["ApprovalState"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var concept in Model.Concepts)
            {
                <tr>
                    <td>@concept.Name</td>
                    <td>@concept.Version</td>
                    <td>@concept.Label</td>
                    <td>@concept.ApprovalState</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>@Localizer["RepresentationRegistrations"]</h2>

<p>@Html.ActionLink(Localizer["AddRepresentationRegistration"].Value, "AddRepresentationRegistration", new { agencyId = Model.Agency.AgencyId })</p>

@if (!Model.Representations.Any())
{
    <p>@Localizer["NoRepresentationRegistrations"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Version"]</th>
                <th>@Localizer["Type"]</th>
                <th>@Localizer["ApprovalState"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var representation in Model.Representations)
            {
                <tr>
                    <td>@representation.Name</td>
                    <td>@representation.Version</td>
                    <td>@representation.Type</td>
                    <td>@representation.ApprovalState</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>@Localizer["VariableRegistrations"]</h2>

<p>@Html.ActionLink(Localizer["AddVariableRegistration"].Value, "AddVariableRegistration", new { agencyId = Model.Agency.AgencyId })</p>

@if (!Model.Variables.Any())
{
    <p>@Localizer["NoVariableRegistrations"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Version"]</th>
                <th>@Localizer["Concept"]</th>
                <th>@Localizer["Representation"]</th>
                <th>@Localizer["ApprovalState"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var variable in Model.Variables)
            {
                <tr>
                    <td>@variable.Name</td>
                    <td>@variable.Version</td>
                    <td>@variable.ConceptIrdi</td>
                    <td>@variable.RepresentationIrdi</td>
                    <td>@variable.ApprovalState</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>@Localizer["ContactInformation"]</h2>

@if (Model.AdminContact != null)
{
    var adminViewData = new ViewDataDictionary(ViewData) { { "CardTitle", Localizer["AdministrativeContact"].Value } };
    <partial name="PersonControl" model="Model.AdminContact" view-data="adminViewData" />
}

@if (Model.TechnicalContact != null)
{
    var techViewData = new ViewDataDictionary(ViewData) { { "CardTitle", Localizer["TechnicalContact"].Value } };
    <partial name="PersonControl" model="Model.TechnicalContact" view-data="techViewData" />
}
