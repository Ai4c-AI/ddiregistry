@model Ddi.Registry.Web.Models.AgencyOverviewModel

@{
    ViewData["Title"] = Model.Agency.AgencyId;
}

<h2>@Model.Agency.AgencyId</h2>

<partial name="AgencyControl" for="Agency" />

<h2>Agency and Sub Agency Assignments</h2>

<p>@Html.ActionLink("Add sub agency assignment", "AddAssignment", new { agencyId = Model.Agency.AgencyId })</p>

@if (Model.Assignments.Count() == 0)
{
    <p>No Sub Agencies have been assigned.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>HTTP Resolution Services</th>
                <th>DNS SRV Services</th>
                <th>Is DNS Delegated</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Ddi.Registry.Data.Assignment a in Model.Assignments)
            {
                <text>
                    <tr>
                        <td>@a.AssignmentId</td>
                        <td>@Model.HttpResolvers[a.AssignmentId].Count()</td>
                        <td>@Model.Services[a.AssignmentId].Count()</td>
                        <td>@a.IsDelegated</td>
                        <td>
                            @Html.ActionLink("Edit", "EditAssignment", new { assignmentId = a.AssignmentId })
                            @if (a.AssignmentId != Model.Agency.AgencyId)
                            {
                                <text>| @Html.ActionLink("Delete", "DeleteAssignment", new { assignmentId = a.AssignmentId })</text>
            }
                        </td>
                    </tr>
                    </text>
                }
        </tbody>
    </table>
}

<h2>Concept Registrations</h2>

<p>@Html.ActionLink("Add concept registration", "AddConceptRegistration", new { agencyId = Model.Agency.AgencyId })</p>

@if (!Model.Concepts.Any())
{
    <p>No Concept Registrations have been submitted.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Version</th>
                <th>Label</th>
                <th>Approval State</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var concept in Model.Concepts)
            {
                <tr>
                    <td>@concept.Name</td>
                    <td>@concept.Version</td>
                    <td>@concept.Label</td>
                    <td>@concept.ApprovalState</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Representation Registrations</h2>

<p>@Html.ActionLink("Add representation registration", "AddRepresentationRegistration", new { agencyId = Model.Agency.AgencyId })</p>

@if (!Model.Representations.Any())
{
    <p>No Representation Registrations have been submitted.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Version</th>
                <th>Type</th>
                <th>Approval State</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var representation in Model.Representations)
            {
                <tr>
                    <td>@representation.Name</td>
                    <td>@representation.Version</td>
                    <td>@representation.Type</td>
                    <td>@representation.ApprovalState</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Variable Registrations</h2>

<p>@Html.ActionLink("Add variable registration", "AddVariableRegistration", new { agencyId = Model.Agency.AgencyId })</p>

@if (!Model.Variables.Any())
{
    <p>No Variable Registrations have been submitted.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Version</th>
                <th>Concept</th>
                <th>Representation</th>
                <th>Approval State</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var variable in Model.Variables)
            {
                <tr>
                    <td>@variable.Name</td>
                    <td>@variable.Version</td>
                    <td>@variable.ConceptIrdi</td>
                    <td>@variable.RepresentationIrdi</td>
                    <td>@variable.ApprovalState</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Contact Information</h2>

@if (Model.AdminContact != null)
{
    var adminViewData = new ViewDataDictionary(ViewData) { { "CardTitle", "Administrative Contact" } };
    <partial name="PersonControl" model="Model.AdminContact" view-data="adminViewData" />
}

@if (Model.TechnicalContact != null)
{
    var techViewData = new ViewDataDictionary(ViewData) { { "CardTitle", "Technical Contact" } };
    <partial name="PersonControl" model="Model.TechnicalContact" view-data="techViewData" />
}
