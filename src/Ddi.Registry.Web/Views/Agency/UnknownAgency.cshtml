@model Ddi.Registry.Web.Models.UnknownAgencyModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<h2>@Localizer["Heading"]</h2>

<p>@Localizer["Body1"] <strong>@Model.AgencyName</strong> @Localizer["Body2"]</p>
<partial name="SearchControl" model="new Ddi.Registry.Web.Models.SearchModel()" />