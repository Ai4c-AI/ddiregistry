@using Ddi.Registry.Data
@model Ddi.Registry.Web.Models.ResolverModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<h2>@Localizer["Heading"]</h2>

<p>@Localizer["AgencyId"]: @Html.ActionLink(Model.Assignment.AgencyId, "Index", "Agency", new { agencyName = Model.Assignment.AgencyId })</p>
<p>@Localizer["UrnAgency"]: @Model.Urn.Agency</p>
<p>@Localizer["Urn"]: @Model.Urn.ToString()</p>
@if (Model.HttpResolvers.Count == 0)
{
    <h2>@Localizer["NoEndpoints"]</h2>
}
else
{

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["ResolverType"]</th>
            <th>@Localizer["Description"]</th>
            <th>@Localizer["Url"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.HttpResolvers)
        {
            string url = item.ResolveUrl(Model.Urn);

            <tr>
                <td>
                    <a href="@url">@item.ResolutionType</a>
                </td>
                <td>
                        @if(item.ResolutionType == HttpResolver.ServiceNameWeb)
                        {
                            <p>@Localizer["WebsiteForUrn"]</p>
                        }
                        else if(item.ResolutionType == HttpResolver.ServiceNameDdiItem)
                        {
                            <p>@Localizer["DdiItemDesc"]</p>
                        }
                        else if(item.ResolutionType == HttpResolver.ServiceNameDdiSet)
                        {
                            <p>@Localizer["DdiSetDesc"]</p>
                        }
                        else
                        {
                            <p>@Localizer["UserDefinedService"]</p>
                        }
                    </td>
                <td>
                    <a href="@url">@url</a>
                </td>

            </tr>
        }
    </tbody>
</table>

}