@model List<Ddi.Registry.Data.Agency>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<h2>@Localizer["SearchResults"]</h2>

@if (Model.Count == 0)
{
    <h2>@Localizer["NoResults"]</h2>
}
else
{

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["AgencyName"]</th>
            <th>@Localizer["Label"]</th>
            <th>@Localizer["DateApproved"]</th>
            <th>@Localizer["LastModified"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.ActionLink(item.AgencyId, "Index", new { agencyName = item.AgencyId })
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Label)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateApproved)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastModified)
                </td>

            </tr>
        }
    </tbody>
</table>

}