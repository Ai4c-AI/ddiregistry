@model IEnumerable<Ddi.Registry.Data.HttpResolver>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Localizer["ResolutionType"]
            </th>
            <th>
                @Localizer["UriTemplate"]
            </th>           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ResolutionType)
                </td>
                <td>
                    @item.UrlTemplate
                </td>
            </tr>
        }
    </tbody>
</table>
