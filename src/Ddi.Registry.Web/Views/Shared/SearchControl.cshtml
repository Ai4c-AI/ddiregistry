@model Ddi.Registry.Web.Models.SearchModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<h3>@Localizer["SearchTheRegistry"]</h3>
<form asp-controller="Agency" asp-action="Index" method="post">
    
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="input-group mb-3">
        <input asp-for="Term" class="form-control" placeholder="@Localizer["SearchPlaceholder"]" aria-label="@Localizer["SearchAriaLabel"]" aria-describedby="button-search" />
        <span asp-validation-for="Term" class="text-danger"></span>
        <div class="input-group-append">
            <button class="btn btn-outline-secondary" type="submit" id="button-search">@Localizer["SearchButton"]</button>
        </div>
    </div>
</form>




