@using Microsoft.AspNetCore.Identity
@using Ddi.Registry.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> Localizer

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="@Localizer["Nav.Manage"]">@User.Identity.Name</a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Manage" asp-action="Index" title="@Localizer["Nav.YourAgencies"]">@Localizer["Nav.YourAgencies"]</a>
        </li>

        <li class="nav-item">
            <a  class="nav-link text-dark" href="https://ddialliance.org/contact-us" title="@Localizer["Nav.ContactDDI"]">@Localizer["Nav.Contact"]</a>
        </li>

        @if (User.IsInRole("admin") || User.IsInRole("SuperAdmin"))
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    @Localizer["Nav.Administration"]
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                    <div class="dropdown-divider">@Localizer["Nav.Admin"]</div>
                    <a class="dropdown-item text-dark" asp-area="" asp-controller="Admin" asp-action="Index" title="@Localizer["Nav.AgencyAdmin"]">@Localizer["Nav.AgencyAdmin"]</a>

                    <a class="dropdown-item text-dark" asp-area="" asp-controller="Help" asp-action="Administrator" title="@Localizer["Nav.AgencyAdminHelp"]">@Localizer["Nav.AgencyAdminHelp"]</a>
                    
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="dropdown-divider">@Localizer["Nav.SuperAdmin"]</div>
                        <a class="dropdown-item text-dark" asp-area="" asp-controller="Admin" asp-action="ShowMembers" title="@Localizer["Nav.Manage"]">@Localizer["Nav.UserAdmin"]</a>
                    }

                </div>
            </li>
        }


        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">@Localizer["Nav.Logout"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a  class="nav-link text-dark" href="https://ddialliance.org/contact-us" title="@Localizer["Nav.ContactDDI"]">@Localizer["Nav.Contact"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">@Localizer["Nav.Register"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">@Localizer["Nav.Login"]</a>
        </li>
    }
</ul>