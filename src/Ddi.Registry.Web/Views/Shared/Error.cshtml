@model ErrorViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<h1 class="text-danger">@Localizer["ErrorHeading"]</h1>
<h2 class="text-danger">@Localizer["ErrorSubheading"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["RequestId"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["DevMode"]</h3>
<p>
    @Localizer["DevModeBody1"]
</p>
<p>
    @Localizer["DevModeBody2"]
    @Localizer["DevModeBody3"]
</p>
