@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<h2>@Localizer["Heading"]</h2>

<p>@Localizer["Intro"]</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["ColTool"]</th>
            <th>@Localizer["ColLicense"]</th>
            <th width="60%">@Localizer["ColDescription"]</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><a href="http://resolver.colectica.com/Home/Develop">Colectica DDI Resolver Library for .NET</a></td>
            <td>LGPL</td>
            <td>
                @Localizer["ResolverDotNet"]
            </td>
        </tr>
        <tr>
            <td><a href="http://resolver.colectica.com/Home/Develop">Colectica DDI Resolver Library for Java</a></td>
            <td>LGPL</td>
            <td>
                @Localizer["ResolverJava"]
            </td>
        </tr>
        <tr>
            <td><a href="/Home/RegistrySource">DDI Registry Source Code</a></td>
            <td>LGPL</td>
            <td>
                @Localizer["RegistrySourceDesc"]
            </td>
        </tr>
    </tbody>
</table>