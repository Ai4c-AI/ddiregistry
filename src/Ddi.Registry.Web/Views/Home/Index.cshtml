@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<div>
    <h1 class="display-4">@Localizer["WelcomeHeading"]</h1>
    <partial name="SearchControl" model="new SearchModel()" />

    <h3>@Localizer["About"]</h3>
    @Html.Raw(Localizer["AboutBody1"].Value)
    @Html.Raw(Localizer["AboutBody2"].Value)

    <h3>@Localizer["RequestAgency"]</h3>
    <p>@Localizer["RequestAgencyIntro"]</p>
    <ol>
        <li>@Localizer["Step1"] <a asp-area="Identity" asp-page="/Account/Login">@Localizer["LoginPage"]</a> @Localizer["Step1Tail"]</li>
        <li>@Localizer["Step2"] <a asp-area="Identity" asp-page="/Account/Register">@Localizer["RegisterHere"]</a> @Localizer["Step2Tail"]</li>
        <li>@Localizer["Step3"] <a href="/Manage">@Localizer["YourAgenciesLink"]</a> @Localizer["Step3Tail"]</li>
    </ol>

    <p>@Localizer["HelpIntro"] @Html.ActionLink(Localizer["DetailedInstructions"].Value, "Index", "Help").</p>
</div>
