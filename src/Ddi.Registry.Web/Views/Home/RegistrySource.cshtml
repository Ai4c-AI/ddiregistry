@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<h2>@Localizer["Heading"]</h2>

<p>@Localizer["Intro"]</p>

<p>@Localizer["Download"]: <a href="http://download.algenta.com/ddi/ddiregistry-1.41-src.zip">DDI Registry</a></p>

<h2>@Localizer["Purpose"]</h2>
@Localizer["PurposeBody"]

<h2>@Localizer["Installation"]</h2>

<h3>@Localizer["Step1"]</h3>
<p>@Localizer["Step1Intro"]</p>
<ul>
<li>.NET 4.0 Framework (the full version)</li>
<li>IIS</li>
</ul>

<h3>@Localizer["Step2"]</h3>
<p>@Localizer["Step2Intro"]</p>
<ul>
<li>ddi_registry</li>
<li>ddi_registry_user</li>
</ul>
<p>@Localizer["Step2Body"]</p>
<ul>
<li>Ddi.Registry.Data/postgres-schema.sql.txt</li>
<li>Ddi.Registry.Data/postgres-membership-schema.sql.txt</li>
</ul>

<h3>@Localizer["Step3"]</h3>
<p>@Localizer["Step3Body"]</p>

<h3>@Localizer["Step4"]</h3>

<h4>@Localizer["CreateSite"]</h4>
<ol>
<li>@Localizer["CreateSiteStep1"]:
	<dl>
		<dt>@Localizer["SiteName"]</dt><dd>MyRegistry</dd>
		<dt>@Localizer["PhysicalPath"]</dt><dd>@Localizer["PhysicalPathValue"]</dd>
		<dt>@Localizer["Binding"]</dt><dd>http</dd>
		<dt>@Localizer["Hostname"]</dt><dd>@Localizer["HostnameValue"]</dd>
	</dl>
</li>
<li>@Localizer["CreateSiteStep2"]</li>
</ol>

<h4>@Localizer["UpdateWebConfig"]</h4>
<p>@Localizer["UpdateWebConfigBody"]</p>

<h3>@Localizer["Step5"]</h3>
<p>@Localizer["Step5Intro"]</p>

<p>@Localizer["Step5Body"]</p>

<ol>
<li>@Localizer["ZoneWriterStep1"]:
	<ul>
		<li>@Localizer["ZoneWriterStep1a"]</li>
		<li>@Localizer["ZoneWriterStep1b"]:
			<dl>
				<dt>BaseZone</dt><dd>@Localizer["BaseZoneDesc"]</dd>
				<dt>MasterName</dt><dd>@Localizer["MasterNameDesc"]</dd>
				<dt>Nameserver</dt><dd>@Localizer["NameserverDesc"]</dd>
				<dt>DefaultARecord</dt><dd>@Localizer["DefaultARecordDesc"]</dd>
				<dt>ZoneFileLocation</dt><dd>@Localizer["ZoneFileLocationDesc"]</dd>
			</dl>
		</li>
	</ul>
</li>
<li>@Localizer["ZoneWriterStep2"]</li>
<li>@Localizer["ZoneWriterStep3"]</li>
</ol>

<h2>@Localizer["Faq"]</h2>
<p>@Localizer["FaqBody"] <a href="mailto:ddiregistry@ddialliance.org">@Localizer["GetInTouch"]</a> @Localizer["FaqTail"]</p>