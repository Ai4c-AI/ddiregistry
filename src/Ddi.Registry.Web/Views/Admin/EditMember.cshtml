@using Microsoft.AspNetCore.Identity
@model Ddi.Registry.Data.ApplicationUser
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"].Value;
}

<h2>@Localizer["EditUser"]</h2>




@using (Html.BeginForm())
{
    @Html.ValidationSummary(Localizer["ValidationSummary"].Value)
    <fieldset>
        <legend>@Localizer["AccountInformation"]</legend>

        <div class="editor-label">
            @Html.Label(Localizer["Name"].Value)
        </div>
        <div class="editor-field">
            @Html.DisplayFor(m => m.Name)
        </div>

        <div class="editor-label">
            @Html.LabelFor(m => m.Email)
        </div>
        <div class="editor-field">
            @Html.DisplayFor(m => m.Email)
        </div>

        <div class="editor-label">
            @Html.LabelFor(m => m.Organization)
        </div>
        <div class="editor-field">
            @Html.DisplayFor(m => m.Organization)
        </div>

    </fieldset>

    <fieldset>
        <legend>@Localizer["Roles"]</legend>

        @foreach (string role in new List<string>() { "admin", "SuperAdmin" })
        {
            <div class="editor-field" style="clear: both;">
                @Html.CheckBox(role, UserManager.IsInRoleAsync(Model, role))
                @Html.Label(role)
            </div>
        }

    </fieldset>

    <input type="submit" value="@Localizer["Update"]" />
}

<div>
    @Html.ActionLink("Back to Member List", "ShowMembers")
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}