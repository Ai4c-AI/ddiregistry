@model Ddi.Registry.Web.Models.ApproveModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"].Value;
}

@functions { 

    public string GetName(string personId)
    {
        if (string.IsNullOrEmpty(personId)) { return "none"; }
        if(Model.People.ContainsKey(personId))
        {
            var p = Model.People[personId];
            if(p != null)
            {
                string result = p.Name;
                if (string.IsNullOrWhiteSpace(result))
                {
                    result += p.Email;
                }
                if(p.Organization != null) {
                    result += " (" + p.Organization + ")";
                }
                return result;

            }
        }
        return "none";
    }
}

<h2>@Localizer["Title"]</h2>

@if (Model.Agencies.Count() == 0)
{
	<p>@Localizer["NoAgenciesToApprove"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Localizer["Username"]
                </th>
                <th>
                    @Localizer["AgencyName"]
                </th>
                <th>
                    @Localizer["Label"]
                </th>
                <th>
                    @Localizer["Created"]
                </th>
                <th>
                    @Localizer["LastModified"]
                </th>
                <th>
                    @Localizer["TechnicalContact"]
                </th>
                <th>
                    @Localizer["AdministrativeContact"]
                </th>
                <th>
                </th>
            </tr>
        </thead>
        <tbody>

    @foreach (var item in Model.Agencies)
    {
        <tr>
            <td>
                <a asp-action="ViewPerson" asp-controller="Manage" asp-route-personId="@item.CreatorId">@GetName(item.CreatorId)</a> 
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AgencyId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Label)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateCreated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastModified)
            </td>
            <td>
                @if (item.TechnicalContactId != null)
                {
                    <a asp-action="ViewPerson" asp-controller="Manage" asp-route-personId="@item.TechnicalContactId">@GetName(item.TechnicalContactId)</a>
                }
                else
                {
                    @GetName(item.TechnicalContactId)
                }

            </td>
            <td>
                @if (item.AdminContactId != null)
                {
                    <a asp-action="ViewPerson" asp-controller="Manage" asp-route-personId="@item.AdminContactId">@GetName(item.AdminContactId)</a>
                }
                else
                {
                    @GetName(item.AdminContactId)
                }
            </td>
            <td>
                @Html.ActionLink(Localizer["Approve"].Value, "Approve", new { agencyId = item.AgencyId }) |
                @Html.ActionLink(Localizer["Delete"].Value, "Delete", new { agencyId = item.AgencyId })
            </td>
        </tr>
    }
        </tbody>
    </table>
}

<h2>@Localizer["ApproveConcepts"]</h2>

@if (!Model.RequestedConcepts.Any())
{
    <p>@Localizer["NoConceptsToApprove"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Agency"]</th>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Version"]</th>
                <th>@Localizer["Label"]</th>
                <th>@Localizer["Created"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.RequestedConcepts)
            {
                <tr>
                    <td>@item.AgencyId</td>
                    <td>@item.Name</td>
                    <td>@item.Version</td>
                    <td>@item.Label</td>
                    <td>@item.CreatedAt</td>
                    <td>
                        @Html.ActionLink(Localizer["Approve"].Value, "ApproveConceptRegistration", new { irdi = item.Irdi }) |
                        @Html.ActionLink(Localizer["Deprecate"].Value, "DeprecateConceptRegistration", new { irdi = item.Irdi })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

