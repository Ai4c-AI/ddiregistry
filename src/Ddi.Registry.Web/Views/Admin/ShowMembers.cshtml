@using Ddi.Registry.Data
@model List<ApplicationUser>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
	ViewData["Title"] = Localizer["Title"].Value;
}
<h2>
	@Localizer["Users"]</h2>
@Html.ValidationSummary()
<p>
	@Html.ActionLink(Localizer["CreateUser"].Value, "Register", "Account")
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Localizer["Name"]
            </th>
            <th>
                @Localizer["Organization"]
            </th>
            <th>
                @Localizer["Email"]
            </th>
            <th></th>
            <!--<th>
        Last Login
    </th>
    <th>
        Comment
    </th>-->
        </tr>
    </thead>
    <tbody>
        @foreach (ApplicationUser item in Model)
        {
        <tr>
            <td>
                @item.Name
            </td>
            <td>
                @item.Organization
            </td>
            <td>
                @item.Email
            </td>
            <td>
                @Html.ActionLink(Localizer["ImpersonateUser"].Value, "ImpersonateUser", new { id = item.Id })
            </td>
        </tr>
        }
    </tbody>
</table>
