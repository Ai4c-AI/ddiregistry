@model Ddi.Registry.Web.Models.DeleteAgencyRequestModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Localizer["DeleteHeading"] @Model.Agency.AgencyId</h2>

<h3>@Localizer["ConfirmDelete"]</h3>
<fieldset>
    <div class="display-label">@Localizer["AgencyName"]</div>
    <div class="display-field">@Model.Agency.AgencyId</div>

    <div class="display-label">@Localizer["Username"]</div>
    <div class="display-field">@Model.Agency.CreatorId</div>

    <div class="display-label">@Localizer["DateCreated"]</div>
    <div class="display-field">@String.Format("{0:g}", Model.Agency.DateCreated)</div>

    <div class="display-label">@Localizer["LastModified"]</div>
    <div class="display-field">@String.Format("{0:g}", Model.Agency.LastModified)</div>

    <div class="display-label">@Localizer["DateApproved"]</div>
    <div class="display-field">@String.Format("{0:g}", Model.Agency.DateApproved)</div>

    <div class="display-label">@Localizer["TechnicalContactId"]</div>
    <div class="display-field">@Model.Agency.TechnicalContactId</div>

    <div class="display-label">@Localizer["AdminContactId"]</div>
    <div class="display-field">@Model.Agency.AdminContactId</div>
</fieldset>

@using (Html.BeginForm()) {

	<fieldset>
		<legend>@Localizer["EnterReason"]</legend>
		@Html.TextAreaFor(model => model.Reason)
	</fieldset>
	
    <p>
        @Html.HiddenFor(model => model.Agency.AgencyId)
        <input type="submit" value="@Localizer["DeleteButton"]" /> |
        @Html.ActionLink(Localizer["BackToList"].Value, "Index")
    </p>
}


