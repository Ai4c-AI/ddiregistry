@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Localizer["Heading"]</h2>

<h3>@Localizer["ProcessRequests"]</h3>
<p>
@Localizer["ProcessRequestsBody1"]
@Html.ActionLink(Localizer["LoggedIn"].Value, "LogIn", "Account")
@Localizer["ProcessRequestsBody2"]
</p>

<p>
@Localizer["ProcessRequestsBody3"]
</p>

<dl>
<dt>@Localizer["Approve"]</dt>
<dd>@Localizer["ApproveBody"]</dd>

<dt>@Localizer["Delete"]</dt>
<dd>@Localizer["DeleteBody"]</dd>
</dl>

<h3>@Localizer["CreateAdminUsers"]</h3>
<p>
@Localizer["CreateAdminUsersBody1"]
@Html.ActionLink(Localizer["LoggedIn"].Value, "LogIn", "Account")
@Localizer["CreateAdminUsersBody2"]
</p>

<p>
@Localizer["CreateAdminUsersBody3"]
</p>

