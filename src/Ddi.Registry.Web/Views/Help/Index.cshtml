@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Localizer["Heading"]</h2>

<h3>@Localizer["RequestAgency"]</h3>

<p>@Localizer["RequestAgencyIntro"]</p>
<ol>
	<li>@Localizer["HelpStep1"] <a asp-area="Identity" asp-page="/Account/Register">@Localizer["RegisterHere"]</a>.</li>
	<li>@Localizer["NavigateTo"] @Html.ActionLink(Localizer["Manage"].Value, "Index", "Manage") @Localizer["WebSiteSection"].</li>
	<li>@Localizer["HelpStep3"]</li>
	<li>@Localizer["HelpStep4"]</li>
</ol>

<h4>@Localizer["AgencyName"]</h4>
<p>@Localizer["AgencyNameBody"]</p>

<h4>@Localizer["ContactPersons"]</h4>
<dl>
	<dt>@Localizer["AdminContact"]</dt>
	<dd>@Localizer["AdminContactBody"]</dd>
	<dt>@Localizer["TechContact"]</dt>
	<dd>@Localizer["TechContactBody"]</dd>
</dl>

<h3>@Localizer["SubAgency"]</h3>
<p>@Localizer["SubAgencyBody"]</p>

<ol>
	<li>@Localizer["NavigateTo"] @Html.ActionLink(Localizer["Manage"].Value, "Index", "Manage") @Localizer["WebSiteSection"].</li>
	<li>@Localizer["SubAgencyStep2"]</li>
	<li>@Localizer["SubAgencyStep3"]</li>
	<li>@Localizer["SubAgencyStep4"]</li>
</ol>

<h3>@Localizer["Resolution"]</h3>
<p>@Localizer["ResolutionBody1"] <a target="_blank" href="http://en.wikipedia.org/wiki/Domain_Name_System">@Localizer["DomainNameSystem"]</a>
@Localizer["ResolutionBody2"]</p>

<ol>
	<li>@Localizer["NavigateTo"] @Html.ActionLink(Localizer["Manage"].Value, "Index", "Manage") @Localizer["WebSiteSection"].</li>
	<li>@Localizer["SubAgencyStep2"]</li>
	<li>@Localizer["ResolutionStep3"]</li>
	<li>@Localizer["ResolutionStep4"]</li>
</ol>
